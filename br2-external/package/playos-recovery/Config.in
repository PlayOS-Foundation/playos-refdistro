config BR2_PACKAGE_PLAYOS_RECOVERY
	bool "playos-recovery"
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_PLAYOS_RUNTIME
	help
	  GL-free recovery UI (Sprint 14, F3). Paints the recovery menu into a
	  wl_shm buffer and rasterises its text in software, so recovery works
	  even when the GPU/GL stack (and with it playos-shell) cannot start.
