# PlayOS ROG Ally kernel config — Linux 6.12 LTS
#
# Minimal config for booting on ASUS ROG Ally (2023) hardware
# with all essential device classes enabled.
#
# Target hardware: AMD Ryzen Z1 Extreme (Phoenix)

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16

# CPU microcode loading
CONFIG_MICROCODE=y
CONFIG_MICROCODE_AMD=y

# EFI boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB_EFI=y
CONFIG_ACPI=y
CONFIG_EFI_PARTITION=y

# Fallback kernel command line (when UEFI doesn't provide one)
CONFIG_CMDLINE="console=tty1 quiet loglevel=3"

# Required filesystems
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Serial console (debug fallback)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Block layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# PCIe
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y

# IOMMU
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_AMD_IOMMU_V2=y

# NVMe storage
CONFIG_BLK_DEV_NVME=y

# USB xHCI + storage (boot medium on the Ally is USB!)
# NOTE: CONFIG_USB core, SCSI and BLK_DEV_SD are mandatory prerequisites —
# without them Kconfig silently drops USB_STORAGE/XHCI and the kernel
# sees no /dev/sd* devices at all.
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ext2/4 rootfs and FAT for ESP
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_MSDOS_PARTITION=y

# ELF binary support
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# DRM/KMS
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_DCN=y
# CONFIG_DRM_SIMPLEDRM is not set — disabled to prevent DRM master contention;
# simpledrm wraps EFI framebuffer as a DRM device and blocks AMDGPU from
# acquiring DRM master, causing the compositor to hang at wlr_backend_start()

# Input — HID and evdev
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_ASUS=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_XBOX=y

# Audio — HDA Intel (ALC294 codec) + CS35L41 smart speaker amps.
#
# The ROG Ally's audio is NOT the AMD ACP/SOF DSP path. Its codec is a
# Realtek ALC294 on the HDA controller, and its internal speakers are two
# Cirrus Logic CS35L41 smart amps on I2C (ACPI HID "CSC3551"). The ALC294
# fixup chain in patch_realtek.c binds those amps through the HDA component
# framework; without the CS35L41 side-codec driver the codec never completes
# binding and exposes no analog PCM to userspace (only the HDMI/DP PCM shows
# up), which is why `default`/dmix fails with "unable to open slave".
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
# ASoC core is a hard dependency of the CS35L41 HDA side-codec driver.
CONFIG_SND_SOC=y
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=y

# I2C — Synopsys DesignWare controller (required for the CS35L41 amps).
#
# The CS35L41 smart amps are enumerated as ACPI I2C devices (HID "CSC3551")
# on a DesignWare I2C controller. Without the controller driver no I2C
# adapter ever probes, so the amps never bind and the ALC294 exposes no
# analog PCM to userspace. Under ACPI the DesignWare platform driver needs
# the common clock framework. On AMD Phoenix the amp bus is shared with the
# AMD PSP, so the PSP semaphore support (and its CCP/PSP driver dependency)
# arbitrates host access to that bus.
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
# AMD CCP/PSP driver (parent CRYPTO_DEV_CCP gates the ccp/Kconfig subtree).
CONFIG_CRYPTO_DEV_CCP=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_SP_PSP=y
CONFIG_I2C_DESIGNWARE_AMDPSP=y

# Power and thermal
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_POWER_SUPPLY=y
CONFIG_X86_AMD_PSTATE=y

# Watchdog (SP5100 TCO on ROG Ally)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_SP5100_TCO=y

# Basic networking (for future use)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y

# Printk and logging
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y

# Disable modules (everything built-in for initramfs)
# CONFIG_MODULES is not set

# Disable WERROR for GCC 13+ compat
# CONFIG_WERROR is not set

# Disable unnecessary subsystems
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_COMPAT is not set
# ALSA dmix (the `default` PCM) needs SysV IPC semaphores/shared memory
# (semget/shmget). Without it, miniaudio/raylib audio init fails with
# "unable to create IPC semaphore" and no sound is produced.
CONFIG_SYSVIPC=y
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
