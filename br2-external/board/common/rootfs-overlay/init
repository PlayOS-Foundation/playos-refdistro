#!/bin/sh
# PlayOS /init — Bootstrap initramfs for Sprint 0
#
# This is a temporary BusyBox-based init script. Sprint 1 replaces it
# with the real playos-init (PID 1 supervisor).
#
# This script:
#   1. Mounts virtual filesystems
#   2. Prints a clear boot banner
#   3. Drops to a BusyBox shell for verification

set -e

# ── Mount virtual filesystems ─────────────────────────────────────
mount -t proc     none /proc
mount -t sysfs    none /sys
mount -t devtmpfs none /dev
mount -t tmpfs    none /tmp

# ── Create runtime directories ─────────────────────────────────────
mkdir -p /run/playos
mkdir -p /data

# ── Boot banner ────────────────────────────────────────────────────
echo ""
echo "  ╔══════════════════════════════════════════════════╗"
echo "  ║              PlayOS — Sprint 0                   ║"
echo "  ║          Build and UEFI Foundation               ║"
echo "  ╚══════════════════════════════════════════════════╝"
echo ""
echo "  Kernel: $(uname -r)"
echo "  Arch:   $(uname -m)"
echo ""
echo "  BusyBox initramfs — Sprint 0 milestone reached!"
echo "  Type 'exit' to shut down."
echo ""

# ── Drop to shell ──────────────────────────────────────────────────
exec /bin/sh
