#!ipxe
# PlayOS netboot diagnostics — enables Alpine initramfs shell tracing.
# Select with: PXE_BOOT_SCRIPT=boot-debug.ipxe bash scripts/setup-pxe-server.sh

set server ${next-server}
set base-url http://${server}/playos

echo == PlayOS Alpine netboot diagnostics ==
echo Server : ${server}
echo Initrd : ${base-url}/initramfs-pxe-lts

kernel ${base-url}/vmlinuz-lts \
    ip=dhcp \
    usbdelay=5 \
    alpine_repo=${base-url}/apks \
    modloop=${base-url}/modloop-lts \
    apkovl=${base-url}/playos.apkovl.tar.gz \
    console=tty0 \
    console=ttyS0,115200 \
    amdgpu.sg_display=0 \
    nomodeset \
    root_size=2G \
    loglevel=7 \
    ignore_loglevel \
    initcall_debug \
    debug_init \
    softlevel=playos-visual

initrd ${base-url}/initramfs-pxe-lts

boot
