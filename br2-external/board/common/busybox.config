# BusyBox configuration for PlayOS Sprint 0 initramfs
#
# Minimal configuration — just enough to boot and drop to a shell.
# Production config will be stripped down further in later sprints.

CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_MKDIR=y
CONFIG_LS=y
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_TEST=y
CONFIG_SLEEP=y
CONFIG_CLEAR=y
CONFIG_UNAME=y
CONFIG_WHICH=y
# initramfs essentials
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_INIT=y
CONFIG_SWAPONOFF=y
CONFIG_FEATURE_MOUNT_HELPERS=y
