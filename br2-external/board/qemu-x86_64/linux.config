# PlayOS minimal kernel config for QEMU x86_64
# Generated for Linux 6.12 LTS
#
# This is a minimal config that boots in QEMU/OVMF with enough
# functionality for Sprint 0 (BusyBox initramfs shell).

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HYPERVISOR_GUEST=y

# EFI boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB_EFI=y

# Required filesystems
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Virtio (QEMU)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO=y

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y

# Basic block devices
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# ext2/4 rootfs
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# A/B pivot + ESP support (qemu-pivot-check exercises the installed-disk path)
# squashfs (gzip) for read-only rootfs slots; vfat/fat for the ESP boot.json.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_DECOMPRESS_GZIP=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# Basic networking (Sprint 11.6 wired SSH; virtio-net for QEMU dev)
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y

# ELF binary support
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Printk and logging
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y

# PCI
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Disable modules (everything built-in for initramfs)
# CONFIG_MODULES is not set

# Disable WERROR for GCC 13+ compat
# CONFIG_WERROR is not set

# DRM / GPU support (for compositor rendering in QEMU)
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y

# Disable unnecessary subsystems
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_COMPAT is not set
# ALSA dmix (the `default` PCM) needs SysV IPC semaphores/shared memory
# (semget/shmget). Without it, miniaudio/raylib audio init fails with
# "unable to create IPC semaphore" and no sound is produced.
CONFIG_SYSVIPC=y
