#!/sbin/openrc-run
# PlayOS Async Trigger — gates the playos-async runlevel behind compositor readiness.
# After the compositor writes /run/playos-visual-ready, this service activates
# the playos-async runlevel (networkmanager, iwd, sshd, and future async services).
# This keeps networking and SSH off the visual critical path (first-frame rule).
#
# CRITICAL: activation must use `openrc --no-stop`. A plain `openrc playos-async`
# SWITCHES runlevels, which stops every started service that is not in the
# target runlevel — that kills seatd and playos-compositor (they live in
# playos-visual), taking the shell down and dropping the device to a VT login
# prompt. --no-stop starts the async services without stopping the visual path.

description="Gate playos-async runlevel on compositor readiness"

depend() {
    after playos-compositor dbus seatd
}

start() {
    ebegin "Waiting for compositor readiness signal"

    # Unblock any soft-blocked radios before NM/iwd come up (handhelds can
    # boot with wlan soft-blocked; harmless if already unblocked).
    rfkill unblock all 2>/dev/null || true

    # Poll for up to 15 seconds. On fast hardware the compositor signals
    # readiness within 1-2 seconds. The generous timeout handles slow
    # first-boot scenarios (firmware load, DRM initialization).
    for _ in $(seq 1 30); do
        if [ -f /run/playos-visual-ready ]; then
            einfo "Compositor signaled ready — activating playos-async runlevel"
            openrc --no-stop playos-async
            _retry_wifi_bg &
            eend 0
            return 0
        fi
        sleep 0.5
    done

    ewarn "Compositor did not signal readiness within 15s"
    ewarn "Activating playos-async runlevel anyway (network may compete with first frame)"
    openrc --no-stop playos-async
    _retry_wifi_bg &
    eend 0
    return 0
}

# Background wifi retry: NM+iwd need a few seconds to scan and attempt
# autoconnect.  If the baked profile hasn't connected after the initial
# window, explicitly activate it.  This works around NM failing to retry
# after a 4-way handshake timeout on a single mesh BSSID.
_retry_wifi_bg() {
    sleep 8
    for _ in $(seq 1 5); do
        if nmcli -t -f STATE general 2>/dev/null | grep -q connected; then
            einfo "WiFi already connected — nothing to do"
            return 0
        fi
        if nmcli connection show messaritisnikhouse >/dev/null 2>&1; then
            einfo "Retrying WiFi connection to messaritisnikhouse (attempt $((_+1))/5)..."
            nmcli connection up messaritisnikhouse 2>/dev/null && break
        fi
        sleep 5
    done
    return 0
}

stop() {
    ebegin "Stopping playos-async-trigger"
    eend 0
}
