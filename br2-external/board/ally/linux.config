# PlayOS ROG Ally kernel config — Linux 6.12 LTS
#
# Minimal config for booting on ASUS ROG Ally (2023) hardware
# with all essential device classes enabled.
#
# Target hardware: AMD Ryzen Z1 Extreme (Phoenix)

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16

# CPU microcode loading
CONFIG_MICROCODE=y
CONFIG_MICROCODE_AMD=y

# EFI boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FB_EFI=y
CONFIG_ACPI=y
CONFIG_EFI_PARTITION=y

# Fallback kernel command line (when UEFI doesn't provide one)
CONFIG_CMDLINE="console=tty1 quiet loglevel=3"

# Required filesystems
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Serial console (debug fallback)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y

# Block layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# PCIe
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y

# IOMMU
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_AMD_IOMMU_V2=y

# NVMe storage
CONFIG_BLK_DEV_NVME=y

# USB xHCI + storage (boot medium on the Ally is USB!)
# NOTE: CONFIG_USB core, SCSI and BLK_DEV_SD are mandatory prerequisites —
# without them Kconfig silently drops USB_STORAGE/XHCI and the kernel
# sees no /dev/sd* devices at all.
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ext2/4 rootfs and FAT for ESP
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_MSDOS_PARTITION=y

# ELF binary support
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# DRM/KMS
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_DCN=y
# CONFIG_DRM_SIMPLEDRM is not set — disabled to prevent DRM master contention;
# simpledrm wraps EFI framebuffer as a DRM device and blocks AMDGPU from
# acquiring DRM master, causing the compositor to hang at wlr_backend_start()

# Input — HID and evdev
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_ASUS=y
CONFIG_HID_PLAYSTATION=y
CONFIG_HID_XBOX=y

# Audio — HDA Intel + SOF
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_AMD_ACP=y
CONFIG_SND_SOC_AMD_ACP6x=y
CONFIG_SND_SOC_AMD_YC_MACH=y
CONFIG_SND_SOC_SOF=y
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=y
CONFIG_SND_SOC_SOF_AMD_ACP=y

# Power and thermal
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_POWER_SUPPLY=y
CONFIG_X86_AMD_PSTATE=y

# Watchdog (SP5100 TCO on ROG Ally)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_SP5100_TCO=y

# Basic networking (for future use)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y

# Printk and logging
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y

# Disable modules (everything built-in for initramfs)
# CONFIG_MODULES is not set

# Disable WERROR for GCC 13+ compat
# CONFIG_WERROR is not set

# Disable unnecessary subsystems
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_COMPAT is not set
# CONFIG_SYSVIPC is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
